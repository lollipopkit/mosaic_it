<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.lollipopkit.unseen</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>MosaicIt</name>
  <summary>On-device privacy redaction for screenshots</summary>
  <developer id="com.lollipopkit">
    <name>lollipopkit</name>
  </developer>
  <description>
    <p>MosaicIt detects and redacts sensitive personal details in screenshots completely on-device without network access.</p>
    <ul>
      <li>Automatic detection of names, faces, avatars, QR codes, phone numbers, addresses, IDs, bank cards, and financial figures</li>
      <li>Runs locally with bundled neural models and zero cloud uploads</li>
      <li>Supports pixelation, blur, and solid redaction styles with manual box editing</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.lollipopkit.unseen.desktop</launchable>
  <url type="homepage">https://mosaic.lollipopkit.com/</url>
  <url type="bugtracker">https://github.com/lollipopkit/mosaic_it/issues</url>
  <url type="vcs-browser">https://github.com/lollipopkit/mosaic_it</url>
  <categories>
    <category>Graphics</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>privacy</keyword>
    <keyword>mosaic</keyword>
    <keyword>redact</keyword>
    <keyword>screenshot</keyword>
  </keywords>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="1.0.0" date="2026-11-27" type="stable">
      <url type="details">https://github.com/lollipopkit/mosaic_it/releases/tag/v1.0.0</url>
    </release>
  </releases>
</component>
